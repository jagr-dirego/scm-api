{
  "name": "scm-api",
  "version": "0.0.1",
  "description": "Backend API de DIREGO SCM con NestJS, Fastify y PostgreSQL.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "bootstrap:admin": "tsx src/bootstrap-admin/bootstrap-admin.command.ts",
    "bootstrap:admin:prod": "node dist/bootstrap-admin/bootstrap-admin.command.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run src",
    "test:integration": "vitest run test/database.integration.spec.ts",
    "test:integration:all": "vitest run test/",
    "test:integration:bootstrap": "vitest run test/bootstrap-admin.integration.spec.ts",
    "test:integration:auth": "vitest run test/auth-login.integration.spec.ts",
    "test:integration:sessions": "vitest run test/session-rotation.integration.spec.ts",
    "test:integration:authorization": "vitest run test/import-authorization.integration.spec.ts",
    "test:integration:audit": "vitest run test/audit.integration.spec.ts",
    "db:test:prepare": "tsx scripts/prepare-test-database.ts",
    "db:test:up": "docker compose -f compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yml down",
    "db:test:logs": "docker compose -f compose.test.yml logs postgres-test",
    "security:argon2:benchmark": "tsx scripts/benchmark-argon2.ts",
    "security:jwt:generate-local": "tsx scripts/generate-jwt-keys.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run test/**/*.e2e-spec.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^10.1.3",
    "@jagr-dirego/scm-database": "1.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "argon2": "0.45.1",
    "drizzle-orm": "1.0.0-rc.4",
    "jose": "6.2.9",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  }
}
