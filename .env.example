# Configuracion de desarrollo. No colocar valores reales en este archivo.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL local de pruebas/desarrollo.
DATABASE_URL=postgresql://scm_app:change_this_in_real_environments@127.0.0.1:5432/scm_kardex_dev

# PostgreSQL aislado de compose.test.yml. Nunca debe apuntar a Dokploy.
TEST_DATABASE_URL=postgresql://scm_test:scm_test_password@127.0.0.1:15433/scm_test

# Seguridad. Completar solo en .env local o en el gestor de secretos del entorno.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=dirego-scm
JWT_ACCESS_TTL_SECONDS=600
JWT_SIGNING_KEY_ID=local-development-key
JWT_PRIVATE_KEY_B64=replace_with_base64_pkcs8_rsa_3072_private_key
JWT_PUBLIC_KEYS_JSON={"local-development-key":"replace_with_base64_spki_rsa_3072_public_key"}
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Desarrollo HTTP local. En produccion usar __Host-dirego_refresh y true.
REFRESH_COOKIE_NAME=dirego_refresh
REFRESH_COOKIE_SECURE=false

# API
CORS_ORIGINS=http://localhost:5173
OPENAPI_ENABLED=true
